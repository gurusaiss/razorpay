# Nirantar reads no required environment variables -- every command in
# README.md's quickstart runs with zero configuration and zero paid
# dependencies. This file documents the one OPTIONAL variable.

# Optional. If set, notify.py's llm_compose() calls the Anthropic API to
# write the free-text explanation in the pre-debit notification (never
# the mandatory fields -- see docs/ARCHITECTURE.md's field-immutability
# rule). If unset, notify.py silently falls back to the free, deterministic
# template -- this is the default and what tests/test_policy_and_notify.py
# exercises, since no key is configured in the reference environment.
NIRANTAR_LLM_API_KEY=
